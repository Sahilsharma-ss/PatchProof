BEGIN;

-- Allow files to be referenced using repo_id + file_id
ALTER TABLE files
ADD CONSTRAINT unique_repo_file_id
UNIQUE (repo_id, file_id);

-- Remove the old single-column foreign key
ALTER TABLE symbols
DROP CONSTRAINT IF EXISTS symbols_file_id_fkey;

-- Add repository-aware foreign key
ALTER TABLE symbols
ADD CONSTRAINT fk_symbols_repository_file
FOREIGN KEY (repo_id, file_id)
REFERENCES files(repo_id, file_id)
ON DELETE CASCADE;

COMMIT;


BEGIN;

-- Allow symbols to be referenced using repo_id + symbol_id
ALTER TABLE symbols
ADD CONSTRAINT unique_repo_symbol_id
UNIQUE (repo_id, symbol_id);

-- Remove the old self-referencing foreign key
ALTER TABLE symbols
DROP CONSTRAINT IF EXISTS symbols_parent_symbol_id_fkey;

-- Add repository-aware self-referencing foreign key
ALTER TABLE symbols
ADD CONSTRAINT fk_symbols_parent_same_repo
FOREIGN KEY (repo_id, parent_symbol_id)
REFERENCES symbols(repo_id, symbol_id)
ON DELETE CASCADE;

COMMIT;


BEGIN;

-- Remove existing single-column foreign keys
ALTER TABLE relationships
DROP CONSTRAINT IF EXISTS relationships_source_file_id_fkey;

ALTER TABLE relationships
DROP CONSTRAINT IF EXISTS relationships_target_file_id_fkey;

ALTER TABLE relationships
DROP CONSTRAINT IF EXISTS relationships_source_symbol_id_fkey;

ALTER TABLE relationships
DROP CONSTRAINT IF EXISTS relationships_target_symbol_id_fkey;


-- File-to-file relationships
ALTER TABLE relationships
ADD CONSTRAINT fk_relationship_source_file
FOREIGN KEY (repo_id, source_file_id)
REFERENCES files(repo_id, file_id)
ON DELETE CASCADE;

ALTER TABLE relationships
ADD CONSTRAINT fk_relationship_target_file
FOREIGN KEY (repo_id, target_file_id)
REFERENCES files(repo_id, file_id)
ON DELETE CASCADE;


-- Symbol-to-symbol relationships
ALTER TABLE relationships
ADD CONSTRAINT fk_relationship_source_symbol
FOREIGN KEY (repo_id, source_symbol_id)
REFERENCES symbols(repo_id, symbol_id)
ON DELETE CASCADE;

ALTER TABLE relationships
ADD CONSTRAINT fk_relationship_target_symbol
FOREIGN KEY (repo_id, target_symbol_id)
REFERENCES symbols(repo_id, symbol_id)
ON DELETE CASCADE;

COMMIT;


BEGIN;

-- Remove the old foreign key
ALTER TABLE unresolved_references
DROP CONSTRAINT IF EXISTS
    unresolved_references_source_symbol_id_fkey;

-- Add repository-aware foreign key
ALTER TABLE unresolved_references
ADD CONSTRAINT fk_unresolved_reference_same_repo
FOREIGN KEY (repo_id, source_symbol_id)
REFERENCES symbols(repo_id, symbol_id)
ON DELETE CASCADE;

COMMIT;



BEGIN;

-- Allow a scan to reference a version from the same repository
ALTER TABLE repository_versions
ADD CONSTRAINT unique_repo_version
UNIQUE (repo_id, version_id);

-- Store the resulting version in scan history
ALTER TABLE scan_history
ADD COLUMN version_id UUID;

-- Enforce that the scan and its version belong to the same repo
ALTER TABLE scan_history
ADD CONSTRAINT fk_scan_history_version
FOREIGN KEY (repo_id, version_id)
REFERENCES repository_versions(repo_id, version_id)
ON DELETE SET NULL (version_id);

COMMIT;


BEGIN;

-- Active status should never be NULL
ALTER TABLE repository_versions
ALTER COLUMN is_active SET DEFAULT FALSE;

ALTER TABLE repository_versions
ALTER COLUMN is_active SET NOT NULL;

-- Only completed versions can become active
ALTER TABLE repository_versions
ADD CONSTRAINT active_version_must_be_completed
CHECK (
    is_active = FALSE
    OR scan_status = 'COMPLETED'
);

COMMIT;



