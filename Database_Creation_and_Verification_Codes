-- 1. users
-- Purpose: Stores users who sign in through GitHub.
-- Each user gets a unique internal user_id. We also store their GitHub ID and basic profile information.

CREATE EXTENSION IF NOT EXISTS pgcrypto;

CREATE TABLE users (
    user_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    github_id BIGINT UNIQUE NOT NULL,
    github_username VARCHAR(255) NOT NULL,

    email VARCHAR(255),
    avatar_url TEXT,

    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);


-- 2. repositories
-- Purpose: Stores information about every unique GitHub repository connected to our application.
-- A repository is stored only once, even if multiple users connect to it.

CREATE TABLE repositories (
    repo_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    github_repo_id BIGINT UNIQUE NOT NULL,
    repo_name VARCHAR(255) NOT NULL,
    full_name VARCHAR(500) NOT NULL,

    description TEXT,
    default_branch VARCHAR(255),
    visibility VARCHAR(20),
    clone_url TEXT NOT NULL,

    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 3. user_repositories
-- Purpose: Establishes the many-to-many relationship between users and repositories.
-- A user can access multiple repositories, and one repository can be shared by multiple users.

CREATE TABLE user_repositories (
    user_id UUID REFERENCES users(user_id)
        ON DELETE CASCADE,

    repo_id UUID REFERENCES repositories(repo_id)
        ON DELETE CASCADE,

    PRIMARY KEY (user_id, repo_id)
);

-- 4. repository_database_registry
-- Purpose: Maps each GitHub repository to its dedicated PostgreSQL RKB database.
-- When another user connects to an already registered repository, our backend finds the existing database and reuses it.

CREATE TABLE repository_database_registry (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    repo_id UUID NOT NULL UNIQUE,
    database_name VARCHAR(255) NOT NULL UNIQUE,

    status VARCHAR(30) NOT NULL DEFAULT 'PROVISIONING',

    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),

    CONSTRAINT fk_repo
        FOREIGN KEY (repo_id)
        REFERENCES repositories(repo_id)
        ON DELETE CASCADE,

    CONSTRAINT valid_status
        CHECK (status IN ('PROVISIONING', 'READY', 'FAILED'))
);


-- 5. files
-- Purpose: Stores metadata about every file in the repository.
-- We use this table to identify files, detect changes and connect files to their code entities.

CREATE TABLE files (
    file_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    file_path TEXT UNIQUE NOT NULL,
    file_name VARCHAR(255) NOT NULL,

    extension VARCHAR(50),
    language VARCHAR(100),

    content_hash VARCHAR(64),
    size_bytes BIGINT,

    is_deleted BOOLEAN DEFAULT FALSE,

    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 6. symbols
-- Purpose: Stores code entities extracted from files using Tree-sitter.
-- A symbol can be a class, function, method, or another code entity we decide to support.

CREATE TABLE symbols (
    symbol_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    file_id UUID NOT NULL
        REFERENCES files(file_id)
        ON DELETE CASCADE,

    parent_symbol_id UUID
        REFERENCES symbols(symbol_id)
        ON DELETE CASCADE,

    symbol_name VARCHAR(255) NOT NULL,
    qualified_name TEXT NOT NULL,

    symbol_type VARCHAR(50) NOT NULL,

    signature TEXT,

    start_line INTEGER,
    end_line INTEGER,

    visibility VARCHAR(30),
    docstring TEXT,

    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);


-- 7. relationships
-- Purpose: Stores connections between files and code symbols.
-- This is the foundation of our dependency graph and impact analysis.

CREATE TABLE relationships (
    relationship_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    source_file_id UUID
        REFERENCES files(file_id) ON DELETE CASCADE,

    target_file_id UUID
        REFERENCES files(file_id) ON DELETE CASCADE,

    source_symbol_id UUID
        REFERENCES symbols(symbol_id) ON DELETE CASCADE,

    target_symbol_id UUID
        REFERENCES symbols(symbol_id) ON DELETE CASCADE,

    relationship_type VARCHAR(50) NOT NULL,

    created_at TIMESTAMPTZ DEFAULT NOW(),

    CONSTRAINT valid_relationship_endpoints CHECK (
        (
            source_file_id IS NOT NULL
            AND target_file_id IS NOT NULL
            AND source_symbol_id IS NULL
            AND target_symbol_id IS NULL
        )
        OR
        (
            source_file_id IS NULL
            AND target_file_id IS NULL
            AND source_symbol_id IS NOT NULL
            AND target_symbol_id IS NOT NULL
        )
    )
);

-- 8. repository_versions
-- Purpose: Tracks successfully built RKB versions.
-- We decided to maintain the latest successfully built RKB as active, while keeping previous version records for tracking.

CREATE TABLE repository_versions (
    version_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    commit_sha VARCHAR(40) NOT NULL,
    branch_name VARCHAR(255),

    scan_status VARCHAR(30) NOT NULL DEFAULT 'PENDING',

    is_active BOOLEAN DEFAULT FALSE,

    started_at TIMESTAMPTZ,
    completed_at TIMESTAMPTZ,

    created_at TIMESTAMPTZ DEFAULT NOW(),

    CONSTRAINT valid_version_status
        CHECK (scan_status IN (
            'PENDING',
            'IN_PROGRESS',
            'COMPLETED',
            'FAILED'
        ))
);

CREATE UNIQUE INDEX one_active_version
ON repository_versions(is_active)
WHERE is_active = TRUE;

-- 9. scan_history
-- Purpose: Records every scanning attempt, including unsuccessful attempts.
-- This is useful for debugging, monitoring and understanding scan failures.

CREATE TABLE scan_history (
    scan_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    commit_sha VARCHAR(40) NOT NULL,
    branch_name VARCHAR(255),

    scan_type VARCHAR(30) NOT NULL,
    scan_status VARCHAR(30) NOT NULL,

    error_message TEXT,

    started_at TIMESTAMPTZ DEFAULT NOW(),
    completed_at TIMESTAMPTZ
);

-- 10. unresolved_references
-- Purpose: Stores code references that our dependency resolver cannot confidently identify.
-- For example, when our resolver sees obj.calculate() but cannot determine which class's calculate() method is called, we record it here.

CREATE TABLE unresolved_references (
    reference_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    source_symbol_id UUID NOT NULL
        REFERENCES symbols(symbol_id)
        ON DELETE CASCADE,

    reference_name VARCHAR(255) NOT NULL,
    reference_type VARCHAR(50),

    line_number INTEGER,

    resolution_status VARCHAR(30) DEFAULT 'UNRESOLVED',

    created_at TIMESTAMPTZ DEFAULT NOW(),

    CONSTRAINT valid_resolution_status
        CHECK (resolution_status IN (
            'UNRESOLVED',
            'AMBIGUOUS'
        ))
);

